# Copia este archivo como .env y reemplaza los placeholders.
# .env está en .gitignore: NUNCA lo subas al repositorio.
ANTHROPIC_API_KEY=tu_key_aqui

# Modelo de Anthropic (default: claude-haiku-4-5-20251001)
MODELO=claude-haiku-4-5-20251001

# Total de llamadas de FORMATO por documento (1 original + reintentos). Rango permitido: 1-5
MAX_INTENTOS=3

# Tokens máximos de salida por llamada (tope duro 8192)
MAX_TOKENS=2048

# Timeout por llamada HTTP en segundos (los reintentos de transporte los hace el SDK)
TIMEOUT_S=60

# Documentos más largos se rechazan sin llamar a la API
MAX_CHARS_DOCUMENTO=20000

# Tolerancia en montos para las reglas de negocio (en unidades de moneda)
TOLERANCIA_MONTOS=0.05
